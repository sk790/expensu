{
  "expo": {
    "name": "SplitMate",
    "slug": "splitmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C5F9EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saurabh.dev.split2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.saurabh.dev.split2"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "1f1f25e3-3f13-4a2c-aa13-4b7c9a30ab88"
      }
    }
  }
}
